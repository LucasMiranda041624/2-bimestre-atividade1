programa
{
	
	funcao inicio()
	{
		real metros, centimetros

		escreva("Digite o valor em metros:")
		leia(metros)

		//Conversão
		centimetros=metros*100

		escreva("\n O valor em centímetros é:", centimetros," cm")
	}
}
